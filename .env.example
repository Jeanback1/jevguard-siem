# Select: local, jev, openrouter, or openai-compatible.
JEVGUARD_AI_PROVIDER=local

# Jev / TypeSafe
TYPESAFE_API_KEY=
JEVGUARD_JEV_MODEL=jev-latest

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Any service that implements OpenAI-compatible chat completions.
# Local services may use http://127.0.0.1; remote services must use HTTPS.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

JEVGUARD_DB_PATH=data/jevguard.db
JEVGUARD_COLLECT_INTERVAL=10
JEVGUARD_ENABLE_LIVE_COLLECTION=true
JEVGUARD_AI_MAX_PER_HOUR=10
JEVGUARD_AI_MAX_PER_DAY=100
JEVGUARD_AI_MIN_SEVERITY=high
JEVGUARD_AI_COOLDOWN_SECONDS=3600
# protocol:port:process-glob; these remain stored locally but do not open incidents.
JEVGUARD_ALLOWED_LISTENERS=tcp:22:sshd,udp:53:*,udp:5353:*
